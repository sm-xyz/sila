[Unit]
Description=SILA Social Integration & Linked Accounts Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sila
ExecStart=/opt/sila/sila-daemon
Restart=always
RestartSec=5s
EnvironmentFile=/opt/sila/sila.env
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
