# ==============================================================================
# SILA (Social Integration & Linked Accounts) - Environment Configuration
# Salin file ini ke /opt/sila/sila.env
# ==============================================================================

# Binding & Port (Default 8092, reverse proxy oleh Caddy)
SILA_BIND=127.0.0.1
SILA_PORT=8092

# Database SQLite Persisten WAL Mode
SILA_DB_PATH=/opt/sila/data/sila.db

# Kunci Rahasia Otorisasi REST API Internal (Wajib dicocokkan dengan solusi-wp)
SILA_SECRET_KEY=sila_secret_internal_auth_key_64_chars_default_token

# Public Gateway URL (Subdomain Caddy dengan Auto-SSL Let's Encrypt)
SILA_PUBLIC_URL=https://sila.domainanda.com

# Meta Developer Credentials (Facebook, Instagram, Threads)
# Dapatkan dari https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=sila_meta_webhook_verify_token_rahasia_123

# Google Cloud Console Credentials (YouTube Data API v3)
# Dapatkan dari https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Batas Konkurensi Worker Antrean Media (Default: 2 untuk VPS hemat memori)
SILA_MAX_CONCURRENCY=2
